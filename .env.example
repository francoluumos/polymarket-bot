# Copy to .env and change the password. Never commit .env.
POSTGRES_USER=market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketdata

# Host port TimescaleDB is exposed on (localhost only)
DB_PORT=5432

# TimescaleDB memory/CPU budget. Default in compose is a conservative 2GB
# for a shared box; on a dedicated 8GB VPS set 4GB.
TS_TUNE_MEMORY=4GB
TS_TUNE_NUM_CPUS=2

# Perp symbols to collect (Binance USDT-margined futures notation).
# Every symbol must exist on BOTH Binance and Bybit (cross-validation).
# VPS production set since 2026-08-10: majors + liquid alt anchor + three
# small/mid-cap memes for cascade & funding-extreme research.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,1000PEPEUSDT,WIFUSDT,1000BONKUSDT

# Open-interest REST poll interval, seconds
OI_POLL_INTERVAL=15

# L2 orderbook snapshot interval, seconds; depth levels stored per side
ORDERBOOK_SNAPSHOT_INTERVAL=1
ORDERBOOK_DEPTH=20

# Polymarket poller
PM_TOP_MARKETS=100
PM_FILLS_INTERVAL=10
PM_MARKETS_INTERVAL=300
PM_POSITIONS_INTERVAL=300
# Comma-separated wallet addresses to snapshot positions for (grows over time)
WATCH_WALLETS=

# Dead-collector alerting: any JSON-accepting webhook (n8n, Slack, Discord).
# Empty = log-only, which is NOT enough for the VPS.
ALERT_WEBHOOK_URL=
HEALTH_CHECK_INTERVAL=60
REALERT_MINUTES=30

# Optional iMessage alerts via Sendblue (sendblue.com): API key/secret from the
# dashboard, from-number = your Sendblue-provisioned line, to = your phone in
# E.164 (+41...). All four empty = channel off.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
ALERT_IMESSAGE_TO=

# Parquet export
EXPORT_BACKFILL_DAYS=3
EXPORT_CHECK_INTERVAL=3600

LOG_LEVEL=INFO
