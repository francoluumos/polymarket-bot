# Copy to .env and change the password. Never commit .env.
POSTGRES_USER=market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketdata

# Host port TimescaleDB is exposed on (localhost only)
DB_PORT=5432

# Perp symbols to collect (Binance USDT-margined futures notation)
SYMBOLS=BTCUSDT,ETHUSDT

# Open-interest REST poll interval, seconds
OI_POLL_INTERVAL=15

# L2 orderbook snapshot interval, seconds
ORDERBOOK_SNAPSHOT_INTERVAL=1

LOG_LEVEL=INFO
